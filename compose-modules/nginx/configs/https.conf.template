server {
    listen 80 default_server;
    listen [::]:80 default_server;
    
    server_name _; # The "_" acts as a catch-all for any unmatched Host header

    # Option A: Drop the connection completely (Recommended)
    # This saves server resources and hides Nginx from IP scanners/bots
    return 444; 

    # Option B: Return a 403 Forbidden error (Alternative)
    # return 403;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    
    server_name _;
    
    ssl_reject_handshake on; 
}

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;

    # API — the ASP.NET app
    location /api/ {
        proxy_pass http://kf-api:8080;
        proxy_http_version 1.1;
        # Server-Sent Events must not be buffered by nginx.
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Web UI — static SPA
    location / {
        proxy_pass http://kf-web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
